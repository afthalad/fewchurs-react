{
  "name": "fewchurs-react-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "test": "pnpm -r --filter \"./packages/*\" test",
    "typecheck": "pnpm -r --filter \"./packages/*\" typecheck",
    "lint": "eslint packages",
    "format": "prettier --check \"packages/**/*.{ts,tsx,css,json}\"",
    "size": "pnpm --filter @fewchurs/react size",
    "check:packaging": "pnpm -r --filter \"./packages/*\" check:packaging",
    "release": "pnpm build && changeset publish",
    "mock": "node tools/mock-server.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "pnpm": {
    "overrides": {
      "human-id": "4.1.3"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
