{
  "name": "@fewchurs/next",
  "version": "1.0.1",
  "description": "A server-rendered Fewchurs feature-request board for Next.js, with the API key kept on the server.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "commonjs",
  "homepage": "https://www.fewchurs.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fewchurs/fewchurs-react.git",
    "directory": "packages/next"
  },
  "keywords": [
    "fewchurs",
    "feature-request",
    "feedback",
    "roadmap",
    "next",
    "nextjs"
  ],
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "handler": [
        "./dist/handler.d.ts"
      ],
      "actions": [
        "./dist/actions.d.ts"
      ],
      "identity": [
        "./dist/identity.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./handler": {
      "import": {
        "types": "./dist/handler.d.mts",
        "default": "./dist/handler.mjs"
      },
      "require": {
        "types": "./dist/handler.d.ts",
        "default": "./dist/handler.js"
      }
    },
    "./actions": {
      "import": {
        "types": "./dist/actions.d.mts",
        "default": "./dist/actions.mjs"
      },
      "require": {
        "types": "./dist/actions.d.ts",
        "default": "./dist/actions.js"
      }
    },
    "./identity": {
      "import": {
        "types": "./dist/identity.d.mts",
        "default": "./dist/identity.mjs"
      },
      "require": {
        "types": "./dist/identity.d.ts",
        "default": "./dist/identity.js"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && node ../../tools/stamp-version.mjs src/version.ts && tsup && node ../../tools/copy-react-styles.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:packaging": "pnpm build && publint && attw --pack . --exclude-entrypoints ./styles.css"
  },
  "dependencies": {
    "@fewchurs/react": "workspace:^",
    "server-only": "^0.0.1"
  },
  "peerDependencies": {
    "next": ">=14",
    "react": ">=18"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.1",
    "@types/react": "^19.0.2",
    "next": "^15.1.0",
    "publint": "^0.2.12",
    "react": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
