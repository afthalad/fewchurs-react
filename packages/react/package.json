{
  "name": "@fewchurs/react",
  "version": "1.0.0",
  "description": "A Fewchurs feature-request board for any React app.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "commonjs",
  "homepage": "https://www.fewchurs.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fewchurs/fewchurs-react.git",
    "directory": "packages/react"
  },
  "keywords": [
    "fewchurs",
    "feature-request",
    "feedback",
    "roadmap",
    "react"
  ],
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "core": [
        "./dist/core.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.mts",
        "default": "./dist/core.mjs"
      },
      "require": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node ../../tools/stamp-version.mjs src/client/version.ts && tsup && node -e \"require('fs').copyFileSync('src/styles.css','dist/styles.css')\"",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "check:packaging": "pnpm build && publint && attw --pack . --exclude-entrypoints ./styles.css"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.16.4",
    "@size-limit/preset-small-lib": "^11.1.6",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "jest-axe": "^9.0.0",
    "jsdom": "^25.0.1",
    "msw": "^2.7.0",
    "publint": "^0.2.12",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "size-limit": "^11.1.6",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "size-limit": [
    {
      "name": "board (js + css)",
      "path": [
        "dist/index.mjs",
        "dist/styles.css"
      ],
      "limit": "15 kB",
      "ignore": [
        "react",
        "react-dom"
      ]
    }
  ],
  "publishConfig": {
    "access": "public"
  }
}
